{
  "corpus": "golden-v0.3",
  "frozen_at": "2026-11-03",
  "hash_algorithm": "sha256",
  "purpose": "The artifact a second implementation is checked against. Each vector carries the module bytes, the execution profile, the expected canonical result and the expected hash, so a new implementation can be verified without running this one. Aimed at the edges where languages actually disagree, not the happy path.",
  "location_note": "Deliberately outside samples/. samples/gen_samples.py rewrites samples/ from the code under test, so a vector living there would be regenerated to match whatever the code did and could never fail.",
  "rules": [
    "Never regenerate to make a test pass.",
    "A deliberate format change gets a new corpus directory plus a documented migration."
  ],
  "trap_codes_covered": [
    "trap.div_by_zero",
    "trap.div_overflow",
    "trap.ip_out_of_range",
    "trap.stack_underflow",
    "trap.step_budget_exceeded"
  ],
  "trap_codes_not_covered": {
    "trap.invalid_opcode": "Unreachable by a valid artifact: parse_module rejects an unknown opcode before execution begins, so no module containing one can be built. The runtime check is defensive and cannot be exercised by a golden vector."
  },
